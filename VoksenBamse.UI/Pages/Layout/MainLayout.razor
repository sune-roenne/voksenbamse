@inherits LayoutComponentBase

<div class="page">
    <div class="background">
        <div id="neon-lights-blue-container" class="neon-lights-container">
            <NeonLightsBlueComponent PixelSize="1600"></NeonLightsBlueComponent>
        </div>
        <div id="neon-lights-pink-container" class="neon-lights-container">
            <NeonLightsPinkComponent PixelSize="1600"></NeonLightsPinkComponent>
        </div>
        <div id="neon-lights-bamse-container" class="neon-lights-container">
            <NeonLightsBamseComponent PixelSize="1600"></NeonLightsBamseComponent>
        </div>
        <div id="bamse-background"></div>
    </div>
    <main>
        <div class="side-nav" id="side-nav">
            <button id="side-nav-expansion-btn">
                <i id="side-nav-expansion-icon" class="bi bi-arrows-expand-vertical"></i>
            </button>
        </div>

       @Body
    </main>
</div>
